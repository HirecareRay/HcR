{"id": 4409711, "status": 3, "overall": 3, "occupation_name": "개발", "employ_status_name": true, "date": "2024. 05", "updated_at": "2026. 06", "do_not_report": false, "city_name": {"id": 1, "name": "서울", "country_id": 2, "weight": 1, "active": true, "created_at": "2014-02-13T19:33:47.000+09:00", "updated_at": "2015-10-26T17:54:22.000+09:00", "is_other": false, "needs_review": false, "parent_id": null}, "title": "그냥저냥 무난한 회사 입니다....!!", "auth": "opened", "pros": "워라벨은 인정. 연봉도 나쁘지는않음. 잘챙겨줌\n장기근속시 유리", "cons": "사실상 파견이고. 업무어려움은 혼자 버텨내야함.\n근무환경및 장비는 별로임", "message_to_management": "장비좀 좋은거좀 주세요. 그리고 평이 좋은 직원들좀 챙겼으면 합니다", "comments": 0, "comment_array": [], "current_page": "/api/v4/companies/reviews/380440/reviews.json?page=1", "is_survey": false, "last_year_at_employer": 2024, "is_recommend_badge_visible": false, "score": {"overall": 3, "advancement_rating": 3, "compensation_rating": 3, "worklife_balance_rating": 4, "culture_rating": 3, "management_rating": 3}, "is_helpful": false, "helpful_count": 1, "next_year_rating": 2, "recommend_to_friend": true, "company_picked": false}
