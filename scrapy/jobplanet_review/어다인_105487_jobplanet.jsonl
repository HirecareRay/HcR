{"id": 5703599, "status": 3, "overall": 3, "occupation_name": "개발", "employ_status_name": false, "date": "2026. 04", "updated_at": "2026. 05", "do_not_report": false, "city_name": {"id": 1, "name": "서울", "country_id": 2, "weight": 1, "active": true, "created_at": "2014-02-13T19:33:47.000+09:00", "updated_at": "2015-10-26T17:54:22.000+09:00", "is_other": false, "needs_review": false, "parent_id": null}, "title": "월급루팡 많고 일 하는 사람만 하는 기업", "auth": "opened", "pros": "중소기업치고는 복지가 꽤 있음\n수익구조가 뚜렷하여 걱정은 없음", "cons": "일 하는 사람만 하고 월급루팡이 많음\n부장 이상급 능력부족 인원 대거 포진\n\n폐급은 꿀빨고 성실한 사람들한테만 일 몰리는 구조", "message_to_management": "사람 보는 눈이 너무 부족하고\n경영만 집중하시길", "comments": 0, "comment_array": [], "current_page": "/api/v4/companies/reviews/105487/reviews.json?page=1", "is_survey": false, "last_year_at_employer": 2022, "is_recommend_badge_visible": false, "score": {"overall": 3, "advancement_rating": 4, "compensation_rating": 2, "worklife_balance_rating": 1, "culture_rating": 3, "management_rating": 2}, "is_helpful": false, "helpful_count": 2, "next_year_rating": 2, "recommend_to_friend": false, "company_picked": false}
